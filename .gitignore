data/*.xlsx
!data/sample_pastificio.xlsx
data/private/
# Configurazione locale (es. che punta a dati veri)
config.local.toml
*.RData
.Rhistory

# Note personali di progetto (non pubbliche)
PIANO.md

# File temporanei di Excel
~$*.xlsx

# Impostazioni locali di VSCode
.vscode/
