# Virtual environment and Python caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Packaging and tool caches
*.egg-info/
.ruff_cache/

# Generated output (recreated by running the program)
output/

# Private data: NEVER in Git
# Every Excel file in data/ is ignored, except the sample one
data/*.xlsx
!data/sample_pastificio.xlsx
data/private/
# Local configuration (e.g. pointing to real data)
config.local.toml
*.RData
.Rhistory

# Personal, non-public notes
PIANO.md
appunti_it/

# Excel temporary files
~$*.xlsx

# Local VSCode settings
.vscode/
